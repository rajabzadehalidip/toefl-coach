# Copy these values into your shell (export ...) or a local .env file you source.
# The app also accepts the key + model from the sidebar at runtime.

OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter model slug, e.g.:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4.1
#   google/gemini-2.5-pro
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
